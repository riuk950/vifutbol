# Supabase Environment Variables Template
# Copy this file to .env and provide your actual values for local development
# Run with: flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

# URL of the Supabase API Gateway (Kong) in Oracle Cloud Infrastructure (DEV)
SUPABASE_URL=https://supabase.artbusinesstechnology.com

# Public anonymous key for the self-hosted Supabase DEV instance
SUPABASE_ANON_KEY=your_dev_anon_key_here

# Isolated PostgreSQL schema for development (production defaults to public)
SUPABASE_SCHEMA=vifutboldev
