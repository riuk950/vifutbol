# ==============================================================================
# Supabase DEV Environment (Servidor Oracle Cloud Self-Hosted)
# ==============================================================================
# Inyección en Flutter:
# flutter run --flavor dev --target lib/env/main.dev.dart --dart-define-from-file=.env.dev

# URL del API Gateway Kong en la instancia Docker de Oracle Cloud
SUPABASE_URL=https://supabase.artbusinesstechnology.com

# Clave pública anónima (anon public key) del host de desarrollo
SUPABASE_ANON_KEY=tu_dev_anon_key_oracle_aqui
