# ==============================================================================
# Supabase PROD Environment (Servidor Oficial Supabase Cloud)
# ==============================================================================
# Inyección en Flutter:
# flutter run --flavor prod --target lib/env/main.prod.dart --dart-define-from-file=.env.prod

# URL del proyecto en Supabase Cloud (ej: https://<project-ref>.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon public key) del proyecto de producción en Supabase Cloud
SUPABASE_ANON_KEY=tu_prod_anon_key_supabase_aqui
